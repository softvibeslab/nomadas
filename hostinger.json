{
  "name": "nomadas-api",
  "version": "1.0.0",
  "description": "NomadShift Platform API",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "npm run build",
    "install": "npm install"
  },
  "environment": {
    "NODE_ENV": "production",
    "PORT": 3000
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/throttler": "^5.1.1",
    "@prisma/client": "^5.8.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "bcrypt": "^5.1.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "winston": "^3.11.0",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "redis": "^4.6.12",
    "aws-sdk": "^2.1540.0",
    "sharp": "^0.33.1"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "npm": ">=10.0.0"
  },
  "deployment": {
    "type": "nodejs",
    "size": "standard",
    "scaling_mode": "scaled_vertically",
    "health_check_path": "/api/health"
  }
}
