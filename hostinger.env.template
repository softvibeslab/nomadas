# NomadShift Platform - Hostinger Production Environment
# ============================================
# CONFIGURACIÓN CON SUPABASE + UPSTASH
# ============================================
# Guías completas en:
# - Supabase: docs/SUPABASE_SETUP.md
# - Upstash: docs/UPSTASH_SETUP.md

# ============================================
# APLICACIÓN
# ============================================
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://tu-frontend.com

# ============================================
# BASE DE DATOS - SUPABASE
# ============================================
# 1. Ve a: https://supabase.com/
# 2. Crea un proyecto nuevo (gratis)
# 3. Ve a Settings > Database > Connection Info
# 4. Copia la "Connection String" o "Connection Pooling" (recomendado)

# Formato Connection Pooling (mejor rendimiento):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# O formato Connection String normal:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# EJEMPLO REAL (reemplaza con tus valores):
# DATABASE_URL="postgresql://postgres.abc123xyz:p4ssw0rd@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require"

# IMPORTANTE: No olvides el ?sslmode=require al final

# ============================================
# REDIS - UPSTASH
# ============================================
# 1. Ve a: https://upstash.com/
# 2. Regístrate y crea un nuevo database (gratis)
# 3. Copia la "REST API URL" o "Redis URL"

# Formato:
REDIS_URL="redis://default:[UPSTASH_PASSWORD]@[DATABASE_NAME]-[ID].upstash.io:6379"

# EJEMPLO REAL (reemplaza con tus valores):
# REDIS_URL="redis://default:U2FsdGVkX1@nomadas-redis-a1b2c3d4.upstash.io:6379"

# IMPORTANTE: El cliente Redis debe tener TLS habilitado:
# socket: { tls: {} }

# ============================================
# JWT - ¡CAMBIA ESTOS VALORES!
# ============================================
# Genera strings seguros aleatorios (mínimo 32 caracteres)
# Comando para generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=tu-jwt-secret-seguro-cambialo-minimo-32-caracteres
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=tu-refresh-secret-seguro-cambialo-minimo-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# AWS S3 (opcional - para archivos)
# ============================================
# Si no usas S3, puedes dejar estos vacíos
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_PHOTOS=
S3_BUCKET_ASSETS=
S3_BUCKET_BACKUPS=
S3_REGION=eu-central-1

# ============================================
# OPENSEARCH (opcional - deshabilitar si no se usa)
# ============================================
OPENSEARCH_NODE=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ============================================
# EMAIL - AWS SES o Hostinger SMTP
# ============================================
SES_REGION=eu-central-1
SES_FROM_EMAIL=noreply@tudominio.com
SES_FROM_NAME=NomadShift

# ============================================
# OAUTH (opcional - Google/Apple login)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ============================================
# CONFIGURACIÓN ADICIONAL
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# CARACTERÍSTICAS DESEHABILITADAS EN HOSTINGER
# ============================================
# WebSocket/Socket.io NO está disponible en Hostinger Cloud
# El código automáticamente deshabilitará estas características
WEBSOCKET_ENABLED=false
