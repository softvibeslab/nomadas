# NomadShift Platform - Hostinger Production Environment
# ============================================
# INSTRUCCIONES: Configura estas variables en el panel de Hostinger
# bajo "Variables de Entorno" o edita este archivo antes del deploy

# ============================================
# APLICACIÓN
# ============================================
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://tu-frontend.com

# ============================================
# BASE DE DATOS - Hostinger PostgreSQL
# ============================================
# Consigue estos datos en: Databases > PostgreSQL
DATABASE_URL="postgresql://usuario:password@host:puerto/nombre_db?schema=public"

# ============================================
# REDIS - Upstash (alternativa gratuita)
# ============================================
# Regístrate en: https://upstash.com/
REDIS_URL="redis://default:password@tu-host.upstash.io:6379"

# ============================================
# JWT - ¡CAMBIA ESTOS VALORES!
# ============================================
# Genera strings seguros aleatorios (mínimo 32 caracteres)
JWT_SECRET=tu-jwt-secret-seguro-cambialo-minimo-32-caracteres
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=tu-refresh-secret-seguro-cambialo-minimo-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# AWS S3 (opcional - para archivos)
# ============================================
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=tu-aws-access-key
AWS_SECRET_ACCESS_KEY=tu-aws-secret-key
S3_BUCKET_PHOTOS=tu-bucket-fotos
S3_BUCKET_ASSETS=tu-bucket-assets
S3_BUCKET_BACKUPS=tu-bucket-backups
S3_REGION=eu-central-1

# ============================================
# OPENSEARCH (opcional - deshabilitar si no se usa)
# ============================================
OPENSEARCH_NODE=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ============================================
# EMAIL - Hostinger SMTP o AWS SES
# ============================================
SES_REGION=eu-central-1
SES_FROM_EMAIL=noreply@tudominio.com
SES_FROM_NAME=NomadShift

# ============================================
# OAUTH (opcional)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ============================================
# CONFIGURACIÓN ADICIONAL
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# CARACTERÍSTICAS DESEHABILITADAS EN HOSTINGER
# ============================================
# WebSocket/Socket.io NO está disponible en Hostinger Cloud
# El código automáticamente deshabilitará estas características
WEBSOCKET_ENABLED=false
