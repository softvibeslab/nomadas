# NomadShift Platform - Production Environment Template for Hostinger
# Copy this to your production environment

NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-frontend-domain.com

# Database - Configure with Hostinger PostgreSQL or external service
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# Redis - Configure with Upstash (free) or Hostinger Redis
REDIS_URL="redis://default:password@host:6379"

# JWT - Generate secure random strings
JWT_SECRET=generate-secure-random-string-min-32-chars
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=generate-another-secure-random-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3 - Configure if using S3 for file storage
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_PHOTOS=
S3_BUCKET_ASSETS=
S3_BUCKET_BACKUPS=
S3_REGION=eu-central-1

# OpenSearch - Optional, can be left empty
OPENSEARCH_NODE=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Email - Configure SMTP or AWS SES
SES_REGION=eu-central-1
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=NomadShift

# OAuth - Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# WebSocket - Disabled for Hostinger Cloud
WEBSOCKET_ENABLED=false
